# API base URL used by the StudioSpace frontend. The backend runs as
# Next.js Route Handlers inside this app (src/app/api) on the same origin,
# so Better Auth cookies flow automatically. Set NEXT_PUBLIC_API_URL=/api.
NEXT_PUBLIC_API_URL=/api

# Admin authorization (server-side only — never prefixed NEXT_PUBLIC_).
# Comma-separated Better Auth account emails that may open /admin pages.
# Must match ADMIN_EMAILS in studio-space-server/.env. Unset = no admins.
ADMIN_EMAILS=admin@example.com

# Database (MongoDB Atlas) — used by the Better Auth server only.
MONGODB_URL="mongodb://<user>:<password>@<host>.mongodb.net:27017/?ssl=true&replicaSet=<replica-set>&authSource=admin"
MONGODB_DB_NAME=studio_space

# Better Auth
# Secret used to sign/hash session tokens — generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=<at-least-32-random-characters>
# Base URL of the Next.js frontend that serves /api/auth.
# REQUIRED on Vercel production — set it to the production URL, e.g.
# https://studio-space-ten.vercel.app (the Google/GitHub authorized redirect
# URIs are {BETTER_AUTH_URL}/api/auth/callback/google|github). .env.local is
# NOT deployed to Vercel, and without this variable Better Auth falls back to
# its localhost:3000 default → Google's redirect_uri_mismatch.
# src/lib/auth.ts additionally falls back to VERCEL_PROJECT_PRODUCTION_URL and
# rejects loopback/LAN hosts (localhost, 10.x, 172.16-31.x, 192.168.x) in
# Vercel production. Cookie-bearing auth POSTs (sign-out, change-password)
# are rejected with 403 INVALID_ORIGIN when the browser origin is not trusted;
# src/lib/auth.ts also trusts VERCEL_URL / VERCEL_PROJECT_PRODUCTION_URL and
# localhost on any port automatically.
BETTER_AUTH_URL=http://localhost:3000
# Optional: extra comma-separated origins allowed to call the auth API
# (e.g. a custom production domain or LAN IP used during development).
# BETTER_AUTH_TRUSTED_ORIGINS=https://studio.example.com

# Google OAuth credentials (optional — provider is disabled until both are set)
# Authorized redirect URI: {BETTER_AUTH_URL}/api/auth/callback/google
GOOGLE_CLIENT_ID=<your-google-oauth-client-id>.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=<your-google-oauth-client-secret>

# GitHub OAuth credentials (optional — provider is disabled until both are set)
# Authorization callback URL: {BETTER_AUTH_URL}/api/auth/callback/github
GITHUB_CLIENT_ID=<your-github-oauth-client-id>
GITHUB_CLIENT_SECRET=<your-github-oauth-client-secret>

# Cloudinary — studio image uploads (server-side only — never NEXT_PUBLIC_).
# Get the three values from the Cloudinary console (Dashboard → Account Details).
# Unset = image uploads answer 503 with setup instructions; external image
# URLs keep working without these.
CLOUDINARY_CLOUD_NAME=<your-cloudinary-cloud-name>
CLOUDINARY_API_KEY=<your-cloudinary-api-key>
CLOUDINARY_API_SECRET=<your-cloudinary-api-secret>

# Optional: set only when the auth API runs on a different origin than the browser client.
# NEXT_PUBLIC_BETTER_AUTH_URL=
